# ==========================================
# MoneyTrack - Environment Configuration
# ==========================================

# 1. Database Configuration (PostgreSQL 16+)
# Local / Development:
DATABASE_URL="postgresql://moneytrack:secretpassword@localhost:5432/moneytrack?schema=public"
# Docker Compose:
# DATABASE_URL="postgresql://moneytrack:your_secure_db_password@db:5432/moneytrack?schema=public"

# Database Container Password (Used by docker-compose.yml)
POSTGRES_USER="moneytrack"
POSTGRES_PASSWORD="your_secure_db_password"
POSTGRES_DB="moneytrack"

# 2. Authentication Configuration (NextAuth v5 / Auth.js)
# Generate a secure 32+ char key with: openssl rand -base64 32
AUTH_SECRET="generate-a-secure-random-32-character-secret-key"
# In Production: set to public domain e.g. https://moneytrack.example.com
AUTH_URL="http://localhost:3000"

# 3. Application Public URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. Node Environment
NODE_ENV="production"
PORT=3000
